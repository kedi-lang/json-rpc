{
  "name": "governed-denied-request",
  "description": "A denied request never reaches the model, and the run fails.",
  "capabilities": [
    "governed",
    "tools"
  ],
  "budget": {
    "request": 1
  },
  "run": {
    "tools": [
      {
        "name": "lookup",
        "description": "Look up a city's country.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string"
            }
          },
          "required": [
            "city"
          ]
        },
        "outputSchema": null,
        "requiredBeforeOutput": false
      }
    ]
  },
  "model": [
    {
      "parts": [
        {
          "type": "toolCall",
          "id": "t1",
          "name": "lookup",
          "arguments": {
            "city": "Lyon"
          }
        }
      ]
    },
    {
      "parts": [
        {
          "type": "text",
          "text": "Never sent."
        }
      ]
    }
  ],
  "tools": {
    "lookup": {
      "result": "France"
    }
  },
  "expect": {
    "failed": true,
    "modelRequests": 1
  }
}
